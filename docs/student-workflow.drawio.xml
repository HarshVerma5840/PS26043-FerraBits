          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ed9" value="pasand aayi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A6785;fontSize=10;" edge="1" parent="1" source="b3" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A6785;fontSize=10;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />

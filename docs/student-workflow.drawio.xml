        <mxCell id="band1" value="1 &#183; Account aur portal participant &#8212; student banne ke do kadam" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF3FB;strokeColor=#B9C6D6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1320" height="360" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="2 &#183; Problem dhoondo &#8212; /portal/problems (sirf published + visible)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF7EF;strokeColor=#B6D2B8;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1320" height="320" as="geometry" />
        </mxCell>
        <mxCell id="band3" value="3 &#183; Submission banao &#8212; DRAFT rahe jab tak submit na karo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6EFF9;strokeColor=#C7B3D4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1320" height="620" as="geometry" />
        </mxCell>
        <mxCell id="band4" value="4 &#183; Review ke liye submit karo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF6EE;strokeColor=#DEC29A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1440" width="1320" height="360" as="geometry" />
        </mxCell>
        <mxCell id="band5" value="5 &#183; Result aur resubmit &#8212; ACCEPTED ya RETURNED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF6EE;strokeColor=#DEC29A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1820" width="1320" height="440" as="geometry" />
        </mxCell>
        <mxCell id="band6" value="6 &#183; Student ke paas kya NAHI hai" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFF2F4;strokeColor=#C2CAD2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="2280" width="1320" height="300" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="&lt;b&gt;POST /auth/register&lt;/b&gt; (phone) &#8594; naya &lt;b&gt;SUBMITTER&lt;/b&gt; user + OTP challenge&lt;br&gt;6-digit code &#183; 5 min TTL &#183; 5 OTP/phone/hour rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="360" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;POST /auth/verify-otp&lt;/b&gt; &#8594; 15-min access JWT + 7-day refresh token (rotate hone wala)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="160" width="360" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;GET /portal/me&lt;/b&gt; &#8594; &lt;b&gt;404 STUDENT_NOT_REGISTERED&lt;/b&gt; (jab HEI source account bhi nahi hai aur participant profile bhi nahi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="262" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;POST /portal/participants&lt;/b&gt; {fullName, email, phone} &#8594; &lt;b&gt;201&lt;/b&gt; participant type = &lt;b&gt;STUDENT&lt;/b&gt;&lt;br&gt;409: profile pehle se hai, ya caller verified HEI source account ka owner hai (wo UNIVERSITY hi rahega)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="352" width="760" height="66" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&#9888; System me &lt;b&gt;STUDENT naam ka koi role nahi&lt;/b&gt; hai &#8212; UserRole sirf SUBMITTER / REVIEWER / ADMIN / EVALUATOR hai. STUDENT ek &lt;b&gt;portal-local participant kind&lt;/b&gt; hai (STUDENT ya UNIVERSITY): user ka role SUBMITTER hi rehta hai, bas portal usse student ki tarah treat karta hai. Participant type dobara change nahi hota." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="160" width="460" height="258" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;GET /portal/problems&lt;/b&gt; &#8212; sirf wo problems jo publish ho chuke hain (cycle EVALUATION_COMPLETED &#8594; publish), newest first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="530" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="STUDENT ke liye filter: access rule &lt;b&gt;OPEN_TO_ALL&lt;/b&gt; wale hi list hote hain &#8212; UNIVERSITY_ONLY aur named-snapshot wale chup-chaap hat jaate hain (leak nahi, bas gayab)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="616" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;GET /portal/problems/{problemId}&lt;/b&gt; &#8212; visible na ho to &lt;b&gt;404&lt;/b&gt; (403 nahi): restricted problem ka &lt;i&gt;existence&lt;/i&gt; bhi leak nahi hota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="702" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Visibility matrix (canSee)&lt;/b&gt;&lt;br&gt;&#183; &lt;b&gt;STUDENT&lt;/b&gt; &#8594; sirf OPEN_TO_ALL&lt;br&gt;&#183; &lt;b&gt;UNIVERSITY&lt;/b&gt; &#8594; OPEN_TO_ALL + UNIVERSITY_ONLY + named snapshot (SELECTED_ / AUTO_SELECTED_UNIVERSITIES) jisme uski institution_name ho (case/whitespace ignore)&lt;br&gt;Yahi ek predicate browse, detail, submission-create aur team-member join &#8212; sab gate karta hai." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="530" width="460" height="238" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;POST /portal/submissions&lt;/b&gt; {problemId, title, summary, githubUrl, links, teamName?, memberUserIds?} &#8594; &lt;b&gt;DRAFT&lt;/b&gt;&lt;br&gt;problem visible hona zaroori, warna 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="870" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;individual&lt;/b&gt;: ek problem pe ek hi active submission (DRAFT / SUBMITTED / UNDER_REVIEW) &#8212; dobara banao to &lt;b&gt;409&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="956" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;team mode&lt;/b&gt; (memberUserIds non-empty ya teamName diya): Team + caller LEADER + baaki MEMBER; har member ko problem dikhna zaroori, warna 403.&lt;br&gt;Team sirf yahin banti hai &#8212; baad me join/add/leave ka koi endpoint nahi hai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1056" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;PATCH /portal/submissions/{id}&lt;/b&gt; &#8212; title / summary / githubUrl / links edit (sirf DRAFT ya RETURNED; null field = unchanged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1156" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;POST /portal/submissions/{id}/files&lt;/b&gt; (multipart, 50 MB cap, sha-256 + sanitized name) &#183; &lt;b&gt;GET .../files&lt;/b&gt; (metadata) &#183; &lt;b&gt;DELETE .../files/{fileId}&lt;/b&gt;&lt;br&gt;sab sirf DRAFT / RETURNED me, aur sirf submitter ya team member" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1242" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;GET /portal/files/{fileId}/download&lt;/b&gt; &#8212; bytes stream hote hain; submitter/team member ke alawa assigned evaluator aur REVIEWER/ADMIN bhi padh sakte hain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1328" width="760" height="66" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&#9888; &lt;b&gt;Artifact zaroori&lt;/b&gt;: submit ke waqt title / summary / GitHub / link / file &#8212; in me se kam se kam ek hona chahiye, warna &lt;b&gt;400&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="870" width="460" height="200" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Files portal ke apne volume me padte hain (app.portal.storage-dir); DB row me immutable metadata + sha-256 rehta hai.&lt;br&gt;&lt;br&gt;Bytes &lt;b&gt;evaluation-service kabhi store nahi karti&lt;/b&gt; &#8212; evaluator bhi isi /portal/files/{fileId}/download URL se, apne JWT ke saath padhta hai." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="1090" width="460" height="304" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;POST /portal/submissions/{id}/submit&lt;/b&gt; &#8212; sirf DRAFT ya RETURNED se chalta hai, warna &lt;b&gt;409&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1510" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="reviewRound &lt;b&gt;+1&lt;/b&gt; &#183; files ka snapshot &#183; evaluation-service ko project-review create push&#8594; wo &lt;b&gt;usi evaluator&lt;/b&gt; ko assign hota hai jisne is problem ke cycle ke scorecards liye the" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1596" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="status &#8594; &lt;b&gt;UNDER_REVIEW&lt;/b&gt; + reviewerUserId + submittedAt store&lt;br&gt;push fail (&lt;b&gt;502&lt;/b&gt;) ya problem abhi evaluate nahi hua (&lt;b&gt;409&lt;/b&gt;) &#8594; poora transaction rollback &#8212; aadha-submitted row kabhi nahi banta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1696" width="760" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="SUBMITTED ek &lt;b&gt;transient&lt;/b&gt; status hai (enum me hai, par persist kabhi nahi hota) &#8212; jo save hota hai wo UNDER_REVIEW hai.&lt;br&gt;&lt;br&gt;Submit ke baad student ke paas &quot;cancel submission&quot; ka koi endpoint nahi hai." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="1510" width="460" height="266" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="Evaluator apne console se &lt;b&gt;ACCEPT&lt;/b&gt; ya &lt;b&gt;RETURN&lt;/b&gt; karta hai (evaluation-service, /evaluation/me/project-reviews)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6EE;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1890" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="portal ko push: &lt;b&gt;POST /internal/submissions/{id}/review-result&lt;/b&gt; {decision, comment} &#8212; idempotent: same terminal state dobara aaye to row unchanged rehti hai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6EE;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1976" width="760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;ACCEPTED&lt;/b&gt; &#8594; terminal (decidedAt + decisionComment set) &#183; &lt;b&gt;RETURNED&lt;/b&gt; &#8594; submitter/team dubara edit kar sakta hai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="2062" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;RETURNED ke baad ka loop&lt;/b&gt;: PATCH meta + files add/delete + &lt;b&gt;POST /submit&lt;/b&gt; &#8594; naya reviewRound, wapas usi evaluator ke paas &#8212; jitne round chahiye" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="2162" width="760" height="66" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;Apne submissions dekho&lt;/b&gt;&lt;br&gt;&#183; &lt;b&gt;GET /portal/submissions&lt;/b&gt; &#8212; apne individual + jis team ka member ho, newest first&lt;br&gt;&#183; &lt;b&gt;GET /portal/submissions/{id}&lt;/b&gt; &#8212; detail + files + team&lt;br&gt;&lt;br&gt;Read model me decisionComment aur reviewRound bhi aate hain, isliye student ko RETURNED ka reason dikhta hai." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="1890" width="460" height="338" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="&lt;b&gt;Problem file karna student ka kaam nahi&lt;/b&gt;: POST /problems ke liye SUBMITTER ka apna ACTIVE + VERIFIED source account chahiye (submitter workflow diagram dekho)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="2350" width="760" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Problem ka status walk (PATCH /problems/{id}/status) ADMIN / EVALUATOR ke paas hai; evaluation pipeline (/evaluation/**) aur project-review ka decision bhi student ke paas nahi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="2450" width="760" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="Student problem ko &lt;b&gt;beech me&lt;/b&gt; kabhi nahi dekhta: pehle poori evaluation pipeline (analyze &#8594; route &#8594; score &#8594; aggregate &#8594; prioritize) chalti hai, phir problem publish hota hai. Isliye jo problem list me dikh rahi hai wo already final hai." style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="2350" width="460" height="180" as="geometry" />
        </mxCell>

        <mxCell id="lg1" value="student ka apna call" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="2620" width="210" height="46" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="submission (draft/file)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="2620" width="210" height="46" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="submit + resubmit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="2620" width="210" height="46" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="result / terminal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="2620" width="210" height="46" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="allowed nahi / error" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="2620" width="210" height="46" as="geometry" />
        </mxCell>
        <mxCell id="lg6" value="note / caveat" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="2620" width="190" height="46" as="geometry" />
        </mxCell>


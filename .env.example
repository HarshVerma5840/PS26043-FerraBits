# Copy to .env and fill in. Compose auto-loads .env.
# Real credentials — never commit the filled-in .env.

# ── OpenAI-compatible LLM (agentrouter / local model) ──────────────────────────
# Empty/absent key is safe: the domain resolver falls back to the deterministic heuristic.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://host.docker.internal:20128/v1
OPENAI_MODEL=agentrouter/deepseek-v4-flash

# ── Gemini (Google AI Studio / Vertex AI) ──────────────────────────────────────
# Required when AI_PROVIDER=gemini. Get a key at https://aistudio.google.com/
# Empty/absent key with AI_PROVIDER=gemini → logs a warning and falls back to deterministic.
GEMINI_API_KEY=
# Current recommended low-latency model for structured classification (Sep 2026).
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.1

# ── AI Provider selector ───────────────────────────────────────────────────────
# Controls which provider AutoUniversitySelectionService uses for domain resolution.
# Options:
#   gemini            → Google Gemini (requires GEMINI_API_KEY)
#   openai-compatible → Local/hosted OpenAI-compatible model (requires OPENAI_API_KEY)
#   deterministic     → Keyword-based fallback, no AI, always available (default)
# Even when gemini or openai-compatible is selected, a failure always falls back to
# deterministic so that problem submission is never blocked by an AI outage.
AI_PROVIDER=deterministic

# ── Phase 2 Evaluation Service AI Scoring ─────────────────────────────────────
# Selects the CriterionScoringClient bean used by AutoEvaluationService.
# Options:
#   openai-compatible  → OpenAiCompatibleCriterionScoringClient (default)
#   gemini             → GeminiCriterionScoringClient (requires GEMINI_API_KEY above)
# Empty/absent key with AI_SCORING_PROVIDER=gemini → pool degrades to MANUAL for that run.
# This does NOT affect Phase 1 domain resolution (controlled by AI_PROVIDER above).
AI_SCORING_PROVIDER=openai-compatible

# Hard kill-switch for AI (AUTO-pool) evaluation scoring.
# When false, every AUTO pool degrades to a human evaluator for that run.
# Does not affect MANUAL pools (they always use human evaluators).
EVALUATION_AUTO_ENABLED=true

# Copy this file to .env.local and fill in values for your environment.
# Development (Vite proxy handles routing — leave VITE_API_BASE_URL blank).
# Production: set VITE_API_BASE_URL to the API Gateway root.

# API Gateway base URL (no trailing slash)
# Leave blank in dev — Vite proxy already forwards to localhost:8080.
VITE_API_BASE_URL=

